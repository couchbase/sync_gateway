// Throwaway probe. Second question: alongside the floating '<version>' tag, what is the newest
// '<version>-<build number>' tag on each cb-vanilla release line, and do the two agree? Prints tags only,
// never the credential. Delete this file, its branch and its job once the answer is recorded.

// Runs nothing else on purpose: no child builds, no GitHub commit status, no Slack. It cannot disturb the
// weekly sweep or the jobs it fans out to.

pipeline {
    agent { label 'very-lightweight-jobs-only' }

    options {
        skipDefaultCheckout()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Probe GHCR builds') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github_ghcr_pat', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
                    sh '''#!/bin/bash
                        set -euo pipefail
                        echo "===== newest cb-vanilla builds, per release line"
                        : > pairs.txt
                        for page in 1 2 3 4 5; do
                            curl -sSf -H "Authorization: Bearer $GHCR_TOKEN" -H "Accept: application/vnd.github+json" \\
                                "https://api.github.com/orgs/cb-vanilla/packages/container/server/versions?per_page=100&page=$page"
                        done | jq -r '.[] | (.metadata.container.tags // []) | select(length > 0) | join(" ")' > pairs.txt
                        echo "tagged versions: $(grep -c . pairs.txt)"
                        echo "-- first 8 tag groups, newest first"
                        head -8 pairs.txt
                        tr ' ' '\\n' < pairs.txt > tags.txt
                        echo "-- per line: the floating tag, the build tag sharing its digest, and the"
                        echo "-- highest build tag on the line, which shows whether the float has lagged"
                        for line in 7.2 7.6 8.0 8.1 8.5; do
                            floating=$(grep -E "^${line}\\.[0-9]+$" tags.txt | sort -V | tail -1 || true)
                            paired=$(grep -E "(^| )${floating}( |$)" pairs.txt | tr ' ' '\\n' |
                                grep -E "^${floating}-[0-9]+$" | head -1 || true)
                            highest=$(grep -E "^${line}\\.[0-9]+-[0-9]+$" tags.txt | sort -V | tail -1 || true)
                            printf 'line %s: floating=%s paired-build=%s highest-build=%s\\n' \\
                                "$line" "${floating:-none}" "${paired:-none}" "${highest:-none}"
                        done
                        rm -f pairs.txt tags.txt
                    '''
                }
            }
        }
    }
}
